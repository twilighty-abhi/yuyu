# Copy to .env and adjust. Local Postgres via: docker compose up -d

DATABASE_URL="postgresql://yuyu:yuyu_dev@localhost:5432/yuyu_dev"

# Redis connection URL (required for distributed rate limiting in production)
# REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth (v5 accepts AUTH_SECRET; NEXTAUTH_SECRET also common)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# For localhost-only development, set this to http://localhost:3000.
# Leave AUTH_URL and NEXTAUTH_URL unset for LAN/mobile development so Auth.js
# derives the host from the incoming request. Set both in production.
# AUTH_URL="http://localhost:3000"

# Comma-separated trusted CDN/reverse-proxy hostnames allowed to invoke Server Actions.
# Leave blank when the browser always uses this application's hostname directly.
ALLOWED_ACTION_ORIGINS=""
# Select only a header your edge proxy overwrites. Cloudflare users should keep this default.
TRUSTED_PROXY_IP_HEADER="cf-connecting-ip"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to 1 when Google credentials are set (exposes the Google button in the UI)
NEXT_PUBLIC_AUTH_GOOGLE_CONFIGURED="0"

# Legacy names still read by many setups (optional if AUTH_* set)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL="http://localhost:3000"

# Comma-separated hosts allowed to request dev assets, for example a LAN IP.
# NEXT_DEV_ALLOWED_ORIGINS="192.168.1.6"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email settings
EMAIL_FROM="Yuyu Events <noreply@localhost>"
# SMTP service name (e.g. "gmail") for quick configuration without host/port.
# If using custom SMTP, leave SMTP_SERVICE empty and configure host/port below.
SMTP_SERVICE=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Secret used by the scheduler to call POST /api/internal/outbox.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
# Secret used by the infrastructure readiness probe for GET /api/health/db.
HEALTHCHECK_SECRET=""

# Stable across all containers serving the same build. Generate with:
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Storage settings (Database-backed file storage in PostgreSQL)
# No S3/R2 settings are needed! Files are stored directly in the PostgreSQL database.
# Optional: Public base URL for uploaded file assets (e.g. "http://localhost:3000")
STORAGE_PUBLIC_BASE_URL=""

# Super admin panel (instance-wide). Only this email can access `/super-admin`.
SUPER_ADMIN_EMAIL=""

# Backup metadata supplied by your managed database backup job or deployment.
# The Operations screen shows these values alongside the last recorded restore drill.
BACKUP_PROVIDER=""
BACKUP_LAST_SUCCESS_AT=""
BACKUP_RETENTION_DAYS="30"
