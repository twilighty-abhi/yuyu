# Copy to .env and adjust. Local Postgres via: docker compose up -d

DATABASE_URL="postgresql://yuyu:yuyu_dev@localhost:5432/yuyu_dev"

# Redis connection URL (required for distributed rate limiting in production)
# REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth (v5 accepts AUTH_SECRET; NEXTAUTH_SECRET also common)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# For localhost-only development, set this to http://localhost:3000.
# Leave AUTH_URL and NEXTAUTH_URL unset for LAN/mobile development so Auth.js
# derives the host from the incoming request. Set both in production.
# AUTH_URL="http://localhost:3000"
# Canonical origin used in generated links. In production this is required and
# must exactly match AUTH_URL, including the HTTPS scheme.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Comma-separated trusted CDN/reverse-proxy hostnames allowed to invoke Server Actions.
# Leave blank when the browser always uses this application's hostname directly.
ALLOWED_ACTION_ORIGINS=""
# Comma-separated HTTPS sites allowed to frame public event embeds. Leave
# blank to disable cross-site embedding; do not use wildcards or paths.
ALLOWED_EMBED_ORIGINS=""
# Select only a header your edge proxy overwrites. Cloudflare users should keep this default.
TRUSTED_PROXY_IP_HEADER="cf-connecting-ip"

# Google OAuth legacy fallback (https://console.cloud.google.com/apis/credentials)
# Prefer Super admin → Settings for new deployments. Values saved there take
# precedence and are encrypted at rest; retain the deployment-secret copy for
# disaster recovery.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Yuyu mobile apps (Android and iOS), all optional.
# Extra Google OAuth client ids accepted as the ID-token audience for mobile
# Google sign-in (in addition to the web client id above), comma-separated.
# GOOGLE_MOBILE_CLIENT_IDS="123-android.apps.googleusercontent.com,123-ios.apps.googleusercontent.com"
# Android App Links: SHA-256 signing-certificate fingerprints, comma-separated.
# ANDROID_APP_SHA256_CERT_FINGERPRINTS="AA:BB:...:FF"
# iOS Universal Links: TEAMID.bundle.id values, comma-separated.
# APPLE_APP_IDS="ABCDE12345.com.twilighty.yuyu"

# Legacy names still read by many setups (optional if AUTH_* set)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL="http://localhost:3000"

# Comma-separated hosts allowed to request dev assets, for example a LAN IP.
# NEXT_DEV_ALLOWED_ORIGINS="192.168.1.6"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email legacy fallback. Prefer Super admin → Settings for new deployments.
# Once SMTP is configured there, every EMAIL_FROM/SMTP_* value below is ignored
# (the two are never mixed); clear the panel's SMTP to fall back to them. Panel
# changes apply on the next send without a restart or rebuild. The stored SMTP
# password is write-only. Blank values here are treated as unset.
EMAIL_FROM="Yuyu Events <noreply@localhost>"
# SMTP service name (e.g. "gmail") for quick configuration without host/port.
# If using custom SMTP, leave SMTP_SERVICE empty and configure host/port below.
SMTP_SERVICE=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Set to 1 only for an intentionally unauthenticated private SMTP relay.
SMTP_ALLOW_UNAUTHENTICATED="0"

# Secret used by the scheduler to call POST /api/internal/outbox.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
# Sent email queue records are removed by the scheduler after this many days.
OUTBOX_RETENTION_DAYS="30"
# Development and tests only: let organisation webhooks reach http:// and
# private/loopback receivers. Ignored by a production server (except the CI
# production-build test mode) and refused by `npm run production:check`.
# WEBHOOKS_ALLOW_PRIVATE_TARGETS="1"
# Secret used by the infrastructure readiness probe for GET /api/health/db.
HEALTHCHECK_SECRET=""

# Valid base64 for a 16, 24, or 32-byte AES key. Keep it stable across all
# containers serving the same build and pass it to `docker build` as a build arg.
# Generate with:
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Independent 32-byte AES key (base64) for authenticator seeds at rest. A
# derived subkey also encrypts the SMTP password, Google client secret, and
# alert webhook URL saved in Super admin → Settings. It must be identical on
# every replica, worker, and migration job, and stable: a different or rotated
# key cannot decrypt those values (email, Google sign-in, alerts, and MFA stop
# working). Check with: node scripts/check-instance-secrets.mjs
MFA_ENCRYPTION_KEY=""

# Private S3-compatible object storage. Endpoint is optional for AWS S3.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="0"

# Super admin panel (instance-wide). Only this email can access `/super-admin`.
SUPER_ADMIN_EMAIL=""

# Operational alerts (Super admin → Settings → Alerts) are configured only in
# the panel; there is no environment variable. Every application process posts
# them to the webhook over outbound HTTPS, so allow that egress.

# Backup posture legacy fallback. Prefer Super admin → Settings for new deployments.
# This only displays backup status; provider backups and restore access stay external.
BACKUP_PROVIDER=""
BACKUP_LAST_SUCCESS_AT=""
BACKUP_RETENTION_DAYS="30"
