# Isolated staging/test deployment only. Do not use this configuration for
# production or real user data: it deliberately permits private, non-TLS
# PostgreSQL, Redis, and MinIO connections inside the Docker network.
NODE_ENV=production

DATABASE_URL="postgresql://yuyu:POSTGRES_PASSWORD@postgres:5432/yuyu_staging"
POSTGRES_PASSWORD="CHANGE_ME"

REDIS_PASSWORD="CHANGE_ME"
REDIS_URL="redis://:REDIS_PASSWORD@redis:6379"

AUTH_URL="https://events.example.com"
NEXT_PUBLIC_BASE_URL="https://events.example.com"

AUTH_SECRET="CHANGE_ME"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="CHANGE_ME"
MFA_ENCRYPTION_KEY="CHANGE_ME"
CRON_SECRET="CHANGE_ME"
HEALTHCHECK_SECRET="CHANGE_ME"

TRUSTED_PROXY_IP_HEADER="x-forwarded-for"
ALLOWED_ACTION_ORIGINS=""

S3_BUCKET="yuyu-staging"
S3_REGION="us-east-1"
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY_ID="yuyu-staging"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_FORCE_PATH_STYLE="1"

MINIO_ROOT_USER="yuyu-staging"
MINIO_ROOT_PASSWORD="CHANGE_ME"

EMAIL_FROM="Yuyu Staging <noreply@events.dev.idliapps.com>"
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_ALLOW_UNAUTHENTICATED="1"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# STAGING/TEST ONLY: required for isolated Docker services that do not use TLS.
# Never set either variable in a real production deployment.
CI="true"
ALLOW_INSECURE_PRODUCTION_TESTS="1"
