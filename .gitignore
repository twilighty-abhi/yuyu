# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# OS / file manager
.DS_Store
Thumbs.db
Desktop.ini

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
*.pem
*.log
*.pid
*.pid.lock
*.seed
*.tgz
logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local caches
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.turbo/
.swc/

# temp
tmp/
temp/
*.tmp

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example

# direnv
.direnv/
.envrc

# AI assistants / agents (local state only)
.claude/
.cursor/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (local/dev artifacts)
prisma/*.db
prisma/*.db-journal
prisma/.env
