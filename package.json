{
  "name": "yuyu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "node scripts/prepare-standalone.mjs && PLAYWRIGHT_PRODUCTION_SERVER=1 playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:verify": "node scripts/verify-production-schema.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "storage:migrate": "node scripts/migrate-assets-to-s3.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "production:check": "node scripts/check-production-env.mjs",
    "brand:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand-assets.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "1.49.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.2.1",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.0.18",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "fontkit": "2.0.4",
    "js-yaml": "^4.3.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
