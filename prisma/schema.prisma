generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum EventPrivacyType {
  PUBLIC
  HIDDEN_LINK
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum RsvpStatus {
  CONFIRMED
  WAITLISTED
  PENDING_APPROVAL
  REJECTED
}

enum RegistrationFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  NUMBER
  DATE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Bcrypt hash for email + password credential logins. Null for OAuth-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  rsvps             RSVP[]
  orgInvitesCreated OrganisationInvite[] @relation("OrgInviteCreatedBy")
  orgInvitesUsed    OrganisationInvite[] @relation("OrgInviteUsedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  logoUrl     String?
  createdAt   DateTime @default(now())

  memberships Membership[]
  invites     OrganisationInvite[]
  events      Event[]
  eventSeries EventSeries[]
  assets      Asset[]
}

model OrganisationInvite {
  id              String         @id @default(cuid())
  organisationId  String
  token           String         @unique
  role            MembershipRole @default(MEMBER)
  createdByUserId String
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("OrgInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy       User?        @relation("OrgInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, createdAt])
  @@index([usedAt])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organisationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Event {
  id                    String           @id @default(cuid())
  organisationId        String
  title                 String
  slug                  String
  description           String           @default("")
  /// Freeform labels used for discovery/search (stored lowercase).
  tags                  String[]         @default([])
  /// Whether public page shows registration counts (confirmed/total).
  showRegistrationCount Boolean          @default(true)
  coverImageUrl         String?
  startDateTime         DateTime
  endDateTime           DateTime
  timezone              String
  location              String           @default("")
  mapLinkUrl            String?
  isOnline              Boolean          @default(false)
  capacity              Int?
  status                EventStatus      @default(DRAFT)
  privacyType           EventPrivacyType @default(PUBLIC)
  createdAt             DateTime         @default(now())

  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rsvps            RSVP[]
  invites          EventInvite[]
  registrationForm EventRegistrationForm?

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, status, privacyType])
}

model EventInvite {
  id        String   @id @default(cuid())
  eventId   String
  email     String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

model EventSeries {
  id                 String           @id @default(cuid())
  organisationId     String
  title              String
  slug               String
  description        String           @default("")
  recurrenceRule     String
  /// Duration applied to each materialized instance (ms)
  instanceDurationMs Int              @default(3600000)
  timezone           String
  privacyType        EventPrivacyType @default(PUBLIC)
  capacity           Int?
  status             EventStatus      @default(DRAFT)
  createdAt          DateTime         @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  instances    EventInstance[]
  invites      SeriesInvite[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model SeriesInvite {
  id            String   @id @default(cuid())
  eventSeriesId String
  email         String
  createdAt     DateTime @default(now())

  series EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)

  @@unique([eventSeriesId, email])
  @@index([eventSeriesId])
}

model EventInstance {
  id            String   @id @default(cuid())
  eventSeriesId String
  startDateTime DateTime
  endDateTime   DateTime
  createdAt     DateTime @default(now())

  series EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  rsvps  RSVP[]

  @@index([eventSeriesId, startDateTime])
}

model RSVP {
  id              String     @id @default(cuid())
  eventId         String?
  eventInstanceId String?
  userId          String?
  guestEmail      String?
  guestName       String?
  /// Stable dedupe key: `user:${userId}` or `guest:${normalizedEmail}`
  attendeeKey     String
  status          RsvpStatus @default(CONFIRMED)
  /// Opaque per-RSVP token for QR / manual check-in (never include PII).
  checkInToken    String     @unique @default(cuid())
  checkedInAt     DateTime?
  createdAt       DateTime   @default(now())

  event         Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventInstance EventInstance? @relation(fields: [eventInstanceId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers       RsvpAnswer[]

  @@index([eventId])
  @@index([eventInstanceId])
  @@index([eventId, attendeeKey])
  @@index([eventInstanceId, attendeeKey])
  @@index([checkInToken])
}

model EventRegistrationForm {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields EventRegistrationField[]

  @@index([eventId])
}

model EventRegistrationField {
  id        String                @id @default(cuid())
  formId    String
  key       String
  label     String
  type      RegistrationFieldType
  required  Boolean               @default(false)
  sortOrder Int                   @default(0)
  /// For SELECT / MULTI_SELECT / RADIO (array of strings)
  options   Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  form    EventRegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers RsvpAnswer[]

  @@unique([formId, key])
  @@index([formId, sortOrder])
  @@index([formId, type])
}

model RsvpAnswer {
  id          String    @id @default(cuid())
  rsvpId      String
  fieldId     String
  valueText   String?
  valueBool   Boolean?
  valueNumber Float?
  valueDate   DateTime?
  createdAt   DateTime  @default(now())

  rsvp  RSVP                   @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  field EventRegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([rsvpId])
  @@index([fieldId])
  @@index([rsvpId, fieldId])
}

/// Tracks stored files (S3/R2/MinIO/etc.) for per-org storage accounting.
/// This is optional for runtime today but enables accurate “bytes stored” metrics.
model Asset {
  id             String   @id @default(cuid())
  organisationId String?
  /// Provider-specific object key (or path).
  key            String   @unique
  /// Public URL if you store it (optional).
  publicUrl      String?
  contentType    String?
  byteSize       BigInt?
  provider       String   @default("unknown")
  fileData       Bytes?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([createdAt])
  @@index([provider])
}
